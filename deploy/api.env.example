# Railway API service ONLY. Fill in its Variables screen; never commit real values.
ENVIRONMENT=production
AUTH_MODE=clerk
AUTO_MIGRATE=false
# Separate restricted runtime login, not the database owner.
DATABASE_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
WEB_ORIGINS=
ADMIN_SUBJECTS=
OPERATOR_NAME=
SUPPORT_EMAIL=
RAILWAY_DOCKERFILE_PATH=apps/api/Dockerfile
AI_PROVIDER=groq
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=groq,gemini,openrouter,mistral,cloudflare
AI_PROVIDER_TIMEOUT_SECONDS=9
AI_TOTAL_TIMEOUT_SECONDS=50
AI_MAX_PROVIDER_ATTEMPTS=3
AI_USER_DAILY_REQUESTS=30
AI_USER_REQUESTS_PER_MINUTE=6
AI_USER_CONCURRENCY=2
AI_GLOBAL_CONCURRENCY=8
AI_GLOBAL_DAILY_TOKENS=1000000
# Required launch choices. Set your budget and a ceiling covering ALL enabled
# model input/output/cached token prices. These are estimates, not invoice limits.
AI_GLOBAL_DAILY_BUDGET_USD=
AI_MAX_USD_PER_MILLION_TOKENS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
# Choose a fixed model before launch; auto routing has variable prices.
OPENROUTER_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
