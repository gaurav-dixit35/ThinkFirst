# Netlify environment ONLY. Never add AI keys or DATABASE_URL here.
# Scope public values to build + runtime; secret key is server-only, NEVER NEXT_PUBLIC.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
THINKFIRST_HOSTED=1
# netlify.toml sets Node 22 and the framework build settings.
# Do not set THINKFIRST_STANDALONE on Netlify; that is for the Docker web image only.
